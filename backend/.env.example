GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SCOPE_CHECK_MODEL=openai/gpt-oss-20b
GROQ_SCOPE_CHECK_MAX_TOKENS=300

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

MATCH_COUNT=5
